<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@color/bg_header">

            <ImageView
                android:id="@+id/btnDrawerMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_btn"
                android:padding="9dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TSUYU"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <ImageView
                android:id="@+id/btnGhost"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_circle_btn"
                android:padding="8dp"
                android:src="@drawable/ic_ghost"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_circle_btn"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar"
                android:scaleType="centerCrop" />
        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_header"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Поиск по юзу (@username)…"
                    android:paddingVertical="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Folder Tabs (Все, Личные, Непрочитанные) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_header"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_active"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Все"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Личные"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tabUnread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Непрочитанные"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dialogsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.35"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Пока нет диалогов"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Найдите собеседника по @юзу"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Side Navigation Drawer (Meow Style) -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#141416"
        android:orientation="vertical">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C1C1E"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/drawerAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/drawerAvatarEdit"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_send_btn"
                    android:padding="4dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/black" />
            </FrameLayout>

            <TextView
                android:id="@+id/drawerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drawerUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/drawerOnlineStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="● в сети"
                android:textColor="@color/green"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/drawerBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Нажмите, чтобы изменить описание..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Drawer Items -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:id="@+id/drawerRowStealth"
                    style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_ghost" />
                    <TextView style="@style/TsuyuSettingLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Режим «Не читать»" />
                    <Switch
                        android:id="@+id/drawerSwitchStealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerRowSound"
                    style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_bell" />
                    <TextView style="@style/TsuyuSettingLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Звук уведомлений" />
                    <Switch
                        android:id="@+id/drawerSwitchSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerRowKeys"
                    style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_key" />
                    <TextView style="@style/TsuyuSettingLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="E2E ключи" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerRowProfile"
                    style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_user" />
                    <TextView style="@style/TsuyuSettingLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Редактировать профиль" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerRowCustomization"
                    style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_palette" />
                    <TextView style="@style/TsuyuSettingLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Кастомизация" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerRowPrivacy"
                    style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_shield" />
                    <TextView style="@style/TsuyuSettingLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Конфиденциальность" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerRowCache"
                    style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_delete" />
                    <TextView
                        android:id="@+id/drawerCacheText"
                        style="@style/TsuyuSettingLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Очистить кэш (0.0 MB)" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#222224" />

                <LinearLayout
                    android:id="@+id/drawerRowLogout"
                    style="@style/SettingRow">
                    <ImageView style="@style/RowIcon"
                        android:src="@drawable/ic_logout"
                        app:tint="#FF3B30" />
                    <TextView style="@style/TsuyuSettingLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Выйти из аккаунта"
                        android:textColor="#FF3B30" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
