<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg">

        <!-- Header (Clean Meow OLED style, minimal with left menu only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:background="@color/bg_header">

            <ImageView
                android:id="@+id/btnDrawerMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle_btn"
                android:padding="10dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TSUYU"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_header"
            android:paddingHorizontal="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Поиск по юзу (@username)…"
                    android:paddingVertical="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Folder Tabs (Все, Личные, Непрочитанные) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_header"
            android:scrollbars="none"
            android:paddingHorizontal="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_active"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Все"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Личные"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tabUnread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Непрочитанные"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dialogsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.35"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Пока нет диалогов"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Найдите собеседника по @юзу"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Side Navigation Drawer (Authentic Meow Style with All Settings inside) -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0A0A0C"
        android:orientation="vertical">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161618"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/drawerAvatar"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/bg_avatar"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/drawerAvatarEdit"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_send_btn"
                    android:padding="5dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/black" />
            </FrameLayout>

            <TextView
                android:id="@+id/drawerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drawerUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/drawerOnlineStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="● в сети"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Editable Bio Box -->
            <LinearLayout
                android:id="@+id/drawerBioWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_drawer_bio"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/drawerBio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Нажмите, чтобы изменить описание..."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Drawer Settings & Options List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section: Режимы и приватность -->
                <TextView style="@style/SectionTitle" android:text="Приватность и режимы" />

                <LinearLayout style="@style/Card">
                    <!-- Режим невидимки -->
                    <LinearLayout
                        android:id="@+id/drawerRowGhost"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_shield" app:tint="@color/white" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView style="@style/TsuyuSettingLabel" android:text="Режим невидимки" />
                            <TextView style="@style/PrivacyValue" android:text="Скрыть статус в сети и активность" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/drawerSwitchGhost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/white"
                            android:trackTint="@color/card_border" />
                    </LinearLayout>

                    <!-- Режим «Не читать» -->
                    <LinearLayout
                        android:id="@+id/drawerRowStealthRead"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_check_double" app:tint="@color/white" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView style="@style/TsuyuSettingLabel" android:text="Режим «Не читать»" />
                            <TextView style="@style/PrivacyValue" android:text="Не отправлять отметки прочтения" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/drawerSwitchStealth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/white"
                            android:trackTint="@color/card_border" />
                    </LinearLayout>

                    <!-- Защита экрана -->
                    <LinearLayout
                        android:id="@+id/drawerRowSecureScreen"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_lock" app:tint="@color/white" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView style="@style/TsuyuSettingLabel" android:text="Защита экрана" />
                            <TextView style="@style/PrivacyValue" android:text="Блокировать снимки экрана" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/drawerSwitchSecure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/white"
                            android:trackTint="@color/card_border" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Оповещения -->
                <TextView style="@style/SectionTitle" android:text="Уведомления и звук" />

                <LinearLayout style="@style/Card">
                    <!-- Звук уведомлений -->
                    <LinearLayout
                        android:id="@+id/drawerRowSound"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_bell" app:tint="@color/white" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView style="@style/TsuyuSettingLabel" android:text="Звук уведомлений" />
                            <TextView android:id="@+id/drawerSoundValue" style="@style/PrivacyValue" android:text="Стандартный" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/drawerSwitchSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/white"
                            android:trackTint="@color/card_border" />
                    </LinearLayout>

                    <!-- Вибрация -->
                    <LinearLayout
                        android:id="@+id/drawerRowVibrate"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_music" app:tint="@color/white" />
                        <TextView style="@style/TsuyuSettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Вибрация" />
                        <Switch
                            android:id="@+id/drawerSwitchVibrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/white"
                            android:trackTint="@color/card_border" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Настройки приложения -->
                <TextView style="@style/SectionTitle" android:text="Настройки Tsuyu" />

                <LinearLayout style="@style/Card">
                    <!-- Профиль -->
                    <LinearLayout
                        android:id="@+id/drawerRowProfile"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_user" app:tint="@color/white" />
                        <TextView style="@style/TsuyuSettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Редактировать профиль" />
                    </LinearLayout>

                    <!-- Кастомизация -->
                    <LinearLayout
                        android:id="@+id/drawerRowCustomization"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_palette" app:tint="@color/white" />
                        <TextView style="@style/TsuyuSettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Оформление и темы" />
                    </LinearLayout>

                    <!-- Конфиденциальность -->
                    <LinearLayout
                        android:id="@+id/drawerRowPrivacy"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_shield" app:tint="@color/white" />
                        <TextView style="@style/TsuyuSettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Конфиденциальность" />
                    </LinearLayout>

                    <!-- E2E Ключи -->
                    <LinearLayout
                        android:id="@+id/drawerRowKeys"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_key" app:tint="@color/white" />
                        <TextView style="@style/TsuyuSettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="E2E ключи шифрования" />
                    </LinearLayout>

                    <!-- Очистить кэш -->
                    <LinearLayout
                        android:id="@+id/drawerRowCache"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon" android:src="@drawable/ic_delete" app:tint="@color/white" />
                        <TextView
                            android:id="@+id/drawerCacheText"
                            style="@style/TsuyuSettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Очистить кэш (0.0 MB)" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Выход -->
                <LinearLayout style="@style/Card" android:layout_marginTop="8dp">
                    <LinearLayout
                        android:id="@+id/drawerRowLogout"
                        style="@style/SettingRow">
                        <ImageView style="@style/RowIcon"
                            android:src="@drawable/ic_logout"
                            app:tint="#FF3B30" />
                        <TextView style="@style/TsuyuSettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Выйти из аккаунта"
                            android:textColor="#FF3B30" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
