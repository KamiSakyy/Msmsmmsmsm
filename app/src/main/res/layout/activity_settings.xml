<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include layout="@layout/part_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView style="@style/SectionTitle" android:text="Уведомления" />

            <LinearLayout style="@style/Card">
                <LinearLayout style="@style/SettingRow">
                    <TextView style="@style/TsuyuSettingLabel" android:text="Уведомления"
                        android:layout_weight="1" android:layout_width="0dp" />
                    <Switch android:id="@+id/swNotif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow">
                    <TextView style="@style/TsuyuSettingLabel" android:text="Вибрация"
                        android:layout_weight="1" android:layout_width="0dp" />
                    <Switch android:id="@+id/swVibrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowSound" style="@style/SettingRow">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/TsuyuSettingLabel" android:text="Звук уведомления" />
                        <TextView android:id="@+id/soundValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/btnTestSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Тест"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:padding="6dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SectionTitle" android:text="Приложение" />

            <LinearLayout style="@style/Card">
                <LinearLayout android:id="@+id/rowCustomization" style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_palette" />
                    <TextView style="@style/TsuyuSettingLabel" android:text="Кастомизация"
                        android:layout_weight="1" android:layout_width="0dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowPrivacy" style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_shield" />
                    <TextView style="@style/TsuyuSettingLabel" android:text="Конфиденциальность"
                        android:layout_weight="1" android:layout_width="0dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowKeys" style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_key" />
                    <TextView style="@style/TsuyuSettingLabel" android:text="Ключи шифрования"
                        android:layout_weight="1" android:layout_width="0dp" />
                </LinearLayout>

                <LinearLayout style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_ghost" />
                    <TextView style="@style/TsuyuSettingLabel" android:text="Режим призрака"
                        android:layout_weight="1" android:layout_width="0dp" />
                    <Switch android:id="@+id/swGhost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingBottom="10dp"
                    android:text="Время захода не обновляется, статус «прочитано» не отправляется."
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <LinearLayout android:id="@+id/rowLogout" style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_logout"
                        app:tint="#FF3B30" />
                    <TextView style="@style/TsuyuSettingLabel" android:text="Выйти"
                        android:textColor="#FF3B30"
                        android:layout_weight="1" android:layout_width="0dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Tsuyu • Double Ratchet E2EE"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
