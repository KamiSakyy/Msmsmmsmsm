<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include layout="@layout/part_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_avatar"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <!-- own profile editor -->
            <LinearLayout
                android:id="@+id/editSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <EditText android:id="@+id/inName" style="@style/TsuyuInput"
                    android:hint="Имя" />

                <EditText android:id="@+id/inBio" style="@style/TsuyuInput"
                    android:hint="Описание" />

                <Button android:id="@+id/btnChangeAvatar" style="@style/TsuyuButtonSecondary"
                    android:text="Сменить аватарку" />

                <Button android:id="@+id/btnSave" style="@style/TsuyuButton"
                    android:text="Сохранить" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMessage"
                style="@style/TsuyuButton"
                android:layout_marginTop="20dp"
                android:text="Написать"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
