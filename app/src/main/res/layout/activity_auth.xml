<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:minHeight="600dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TSUYU"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:maxWidth="320dp"
            android:gravity="center"
            android:text="Сквозное шифрование Double Ratchet. Приватные ключи никогда не покидают устройство."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_secondary"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E2EE • Signal Double Ratchet"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- avatar picker (register only) -->
        <FrameLayout
            android:id="@+id/avatarWrap"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:background="@drawable/bg_avatar"
                android:scaleType="centerCrop" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_send_btn"
                android:padding="5dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/black"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </FrameLayout>

        <EditText
            android:id="@+id/inName"
            style="@style/TsuyuInput"
            android:hint="Имя"
            android:inputType="textPersonName"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inUsername"
            style="@style/TsuyuInput"
            android:hint="Юз (@username)"
            android:inputType="text"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inBio"
            style="@style/TsuyuInput"
            android:hint="Описание"
            android:inputType="text"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inEmail"
            style="@style/TsuyuInput"
            android:hint="Почта"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/inPassword"
            style="@style/TsuyuInput"
            android:hint="Пароль"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="360dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrimary"
            style="@style/TsuyuButton"
            android:text="Войти" />

        <Button
            android:id="@+id/btnSwitch"
            style="@style/TsuyuButtonSecondary"
            android:text="Создать аккаунт" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
